{
  "name": "@wizeworksllc/email-platform",
  "version": "0.0.0",
  "private": true,
  "description": "sparx Email Platform — management service layer (settings, sending domains, templates, automations, broadcasts, suppressions, analytics) shared by REST + MCP + Server Actions. @wizeworksllc/email stays the render lib; this owns the domain logic (docs/13-email-platform-prd.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@wizeworksllc/builder-schemas": "workspace:*",
    "@wizeworksllc/db": "workspace:*",
    "@wizeworksllc/email": "workspace:*",
    "@wizeworksllc/events": "workspace:*",
    "@wizeworksllc/brand-core": "workspace:*",
    "@wizeworksllc/silica-catalog": "workspace:*",
    "@wizeworksllc/site-themes": "workspace:*",
    "@wizeworksllc/ui": "workspace:*",
    "lucide-react": "^0.577.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
