{
  "name": "@wizeworksllc/commerce",
  "version": "0.0.0",
  "private": true,
  "description": "sparx Commerce — service layer (single source of truth shared by REST, GraphQL, MCP, Server Actions, storefront, and B2B portal), event consumers, MCP tool registry. Mirrors @wizeworksllc/crm's locked decision #7 architecture: one service layer, many transports.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    },
    "./consumers": {
      "types": "./src/consumers/index.ts",
      "default": "./src/consumers/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo",
    "db:backfill:plain-descriptions": "tsx scripts/backfill-plain-descriptions.ts"
  },
  "dependencies": {
    "@wizeworksllc/auth": "workspace:*",
    "@wizeworksllc/channels": "workspace:*",
    "@wizeworksllc/commerce-schemas": "workspace:*",
    "@wizeworksllc/crm": "workspace:*",
    "@wizeworksllc/crm-schemas": "workspace:*",
    "@wizeworksllc/db": "workspace:*",
    "@wizeworksllc/events": "workspace:*",
    "@wizeworksllc/field-schema": "workspace:*",
    "@wizeworksllc/integration-framework": "workspace:*",
    "@wizeworksllc/inventory": "workspace:*",
    "@wizeworksllc/links": "workspace:*",
    "@wizeworksllc/media": "workspace:*",
    "@wizeworksllc/payments": "workspace:*",
    "@wizeworksllc/search": "workspace:*",
    "@wizeworksllc/time": "workspace:*",
    "@wizeworksllc/ui": "workspace:*",
    "lucide-react": "^0.577.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
