{
  "name": "@wizeworksllc/usage-meters",
  "version": "0.0.0",
  "description": "The capacity vocabulary with no database behind it: the meters, how a reading is judged against its limit, and the capacity report shape. @wizeworksllc/usage measures tenants and re-exports it.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wizeworksllc/platform.git",
    "directory": "wizeworks/packages/usage-meters"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
