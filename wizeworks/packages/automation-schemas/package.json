{
  "name": "@wizeworksllc/automation-schemas",
  "version": "0.0.0",
  "description": "sparx Automation — Zod schemas + types for the automation rule document (trigger / condition / action / gate-log) shared across engine, REST, MCP (docs/81-automation-module.md, docs/84-automation-build-log.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wizeworksllc/sparx.git",
    "directory": "wizeworks/packages/automation-schemas"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
