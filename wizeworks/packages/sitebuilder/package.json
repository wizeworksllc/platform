{
  "name": "@wizeworksllc/sitebuilder",
  "version": "0.0.0",
  "private": true,
  "description": "sparx Site Builder — service layer (theme/section/layout/publish/schedule), events, MCP tools, and dashboard manifest. One service, many transports (docs/29-sitebuilder-architecture.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@wizeworksllc/db": "workspace:*",
    "@wizeworksllc/silica-catalog": "workspace:*",
    "@wizeworksllc/site-themes": "workspace:*",
    "@wizeworksllc/sitebuilder-schemas": "workspace:*",
    "@wizeworksllc/ui": "workspace:*",
    "lucide-react": "^0.577.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
