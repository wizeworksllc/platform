{
  "name": "@wizeworksllc/auth",
  "version": "0.0.0",
  "private": true,
  "description": "sparx authentication \u00e2\u20ac\u201d Better Auth server + client configured with the sparx Prisma adapter and tenant/organization plugin (docs/16-auth-security.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./org-roles": {
      "types": "./src/org-roles.ts",
      "default": "./src/org-roles.ts"
    },
    "./module-access": {
      "types": "./src/module-access.ts",
      "default": "./src/module-access.ts"
    },
    "./property-access": {
      "types": "./src/property-access.ts",
      "default": "./src/property-access.ts"
    },
    "./friendly-slug": {
      "types": "./src/friendly-slug.ts",
      "default": "./src/friendly-slug.ts"
    },
    "./mcp-scopes": {
      "types": "./src/mcp-scopes.ts",
      "default": "./src/mcp-scopes.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-signup.ts",
    "clean": "rm -rf .turbo dist *.tsbuildinfo",
    "test": "vitest run --maxWorkers=1 --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@prisma/client": "^6.19.3",
    "@wizeworksllc/attribution": "workspace:*",
    "@wizeworksllc/auth-client": "workspace:*",
    "@wizeworksllc/brand-core": "workspace:*",
    "@wizeworksllc/db": "workspace:*",
    "@wizeworksllc/email": "workspace:*",
    "@wizeworksllc/events": "workspace:*",
    "@wizeworksllc/legal": "workspace:*",
    "@wizeworksllc/legal-seed": "workspace:*",
    "@wizeworksllc/links": "workspace:*",
    "@wizeworksllc/modules": "workspace:*",
    "better-auth": "~1.7.14",
    "jose": "^6.2.3"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "dotenv": "^16.4.7",
    "next": "^16.4.1",
    "react": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
