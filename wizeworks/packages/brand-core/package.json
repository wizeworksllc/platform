{
  "name": "@wizeworksllc/brand-core",
  "version": "0.0.0",
  "description": "The platform's brand CONTRACT — which brands exist and what identity each must supply. Brand-blind by construction: it declares the shape and resolves values from configuration, and states none of its own.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./request-scope": {
      "types": "./src/request-scope.ts",
      "default": "./src/request-scope.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wizeworksllc/platform.git",
    "directory": "wizeworks/packages/brand-core"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
