{
  "name": "@wizeworks/api-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "sparx MCP server — exposes per-module tool registries (today: @wizeworksllc/crm's crmMcpTools) to Claude / ChatGPT / Copilot via Streamable HTTP. JWT-authenticated for now; API-key issuance lands when the dashboard's AI Integrations settings page does.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --import tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@prisma/client": "^6.19.3",
    "@wizeworksllc/api-core": "workspace:*",
    "@wizeworksllc/auth": "workspace:*",
    "@wizeworksllc/automation": "workspace:*",
    "@wizeworksllc/automation-schemas": "workspace:*",
    "@wizeworksllc/b2b": "workspace:*",
    "@wizeworksllc/builder": "workspace:*",
    "@wizeworksllc/client-ip": "workspace:*",
    "@wizeworksllc/cms": "workspace:*",
    "@wizeworksllc/commerce": "workspace:*",
    "@wizeworksllc/crm": "workspace:*",
    "@wizeworksllc/db": "workspace:*",
    "@wizeworksllc/email-platform": "workspace:*",
    "@wizeworksllc/events": "workspace:*",
    "@wizeworksllc/funnels": "workspace:*",
    "@wizeworksllc/godaddy": "workspace:*",
    "@wizeworksllc/inventory": "workspace:*",
    "@wizeworks/lens-node": "0.3.0-alpha.11",
    "@wizeworksllc/links": "workspace:*",
    "@wizeworksllc/media": "workspace:*",
    "@wizeworksllc/registrar": "workspace:*",
    "@wizeworksllc/scheduling": "workspace:*",
    "@wizeworksllc/scheduling-schemas": "workspace:*",
    "@wizeworksllc/search": "workspace:*",
    "@wizeworksllc/sitebuilder": "workspace:*",
    "@wizeworksllc/social": "workspace:*",
    "@wizeworksllc/socket-bus": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^16.4.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
