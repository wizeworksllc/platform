{
  "name": "@wizeworks/event-worker",
  "version": "0.0.0",
  "private": true,
  "description": "The sparx event worker: one process running every broker subscription that does not need its own runtime. Every handler is a library under packages/*-worker; media-worker and import-worker stay separate. See src/index.ts for why.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --import tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@wizeworksllc/automation-worker": "workspace:*",
    "@wizeworksllc/cache-revalidation-worker": "workspace:*",
    "@wizeworksllc/channel-sync-worker": "workspace:*",
    "@wizeworksllc/commerce-indexer": "workspace:*",
    "@wizeworksllc/db": "workspace:*",
    "@wizeworksllc/domain-worker": "workspace:*",
    "@wizeworksllc/dropship-worker": "workspace:*",
    "@wizeworksllc/email-worker": "workspace:*",
    "@wizeworksllc/events": "workspace:*",
    "@wizeworksllc/finance-worker": "workspace:*",
    "@wizeworksllc/staff-worker": "workspace:*",
    "@wizeworksllc/inventory-worker": "workspace:*",
    "@wizeworksllc/legal-seed-worker": "workspace:*",
    "@wizeworksllc/markup-recompute-worker": "workspace:*",
    "@wizeworksllc/platform-crm-worker": "workspace:*",
    "@wizeworksllc/push-worker": "workspace:*",
    "@wizeworksllc/social-worker": "workspace:*",
    "pino": "^9.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
