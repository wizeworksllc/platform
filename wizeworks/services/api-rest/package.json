    "ops:migrate-media-to-blob": "node --import tsx src/scripts/migrate-media-to-blob.ts",
    "ops:backfill-finance-categories": "node --import tsx src/scripts/backfill-finance-categories.ts",
    "ops:reindex-search": "node --import tsx src/scripts/reindex-search.ts",
    "ops:backfill-blueprint-scoping": "node --import tsx src/scripts/backfill-blueprint-scoping.ts",
    "ops:repair-cross-brand-subdomains": "node --import tsx src/scripts/repair-cross-brand-subdomains.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
